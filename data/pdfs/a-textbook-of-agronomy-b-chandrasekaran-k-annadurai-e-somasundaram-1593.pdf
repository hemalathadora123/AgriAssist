<?xpacket begin="ï»¿" id="W5M0MpCehiHzreSzNTczkc9d"?>
<x:xmpmeta xmlns:x="adobe:ns:meta/" x:xmptk="Adobe XMP Core 5.4-c005 78.147326, 2012/08/23-13:03:03        ">
   <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
      <rdf:Description rdf:about=""
            xmlns:pdf="http://ns.adobe.com/pdf/1.3/"
            xmlns:photoshop="http://ns.adobe.com/photoshop/1.0/"
            xmlns:xmp="http://ns.adobe.com/xap/1.0/"
            xmlns:xmpMM="http://ns.adobe.com/xap/1.0/mm/"
            xmlns:xmpRights="http://ns.adobe.com/xap/1.0/rights/"
            xmlns:dc="http://purl.org/dc/elements/1.1/">
         <pdf:Producer>Acrobat Distiller 6.0 (Windows)</pdf:Producer>
         <pdf:Keywords>812242743X&#xD;&#xA;9788122427431</pdf:Keywords>
         <photoshop:AuthorsPosition>Chandrasekaran</photoshop:AuthorsPosition>
         <photoshop:CaptionWriter>Prof. (Dr.) B. Chandrasekaran is Director of Research, Tamil Nadu Agricultural University, Coimbatore where he has served in various positions for a period of 28 years in the areas of research, teaching, extension, management and administration. His major fields of specialization are water management and integrated farming system practices. He is Pioneer in the establishment of Plant Clinic Centre at Tamirabarani river basin, large scale introduction of direct sown rice system in Union Territory of Pondicherry and large scale demonstration on farm mechanization with Ipomoea cutter, Paddy transplanter, Reaper and Combined harvester in Cauvery Delta Zone. He has taught Agronomy courses for the graduate and postgraduates and Doctoral scholars. He has published more than 150 research papers and 12 books. He is life member of eight professional societies. He is a recipient of various fellowships from Food and Agricultural Organization (FAO), Rome; International Rice Research Institute (IRRI), Philippines; Asian Productivity Organization (APO), Japan; International Bibliography Institute (IBI), USA. He received `Bharathiar Award` for the publication of best Tamil book on Rice Production, Best Research paper award from Indian Society of Agronomy, New Delhi and `Best Agronomist Award` from Makkal Sakthi Iyakkam awarded by Cauvery Delta Zone farmers for his significant contributions for the rice farming. He served as Director, Tamil Nadu Rice Research Institute, Tamil Nadu Agricultural University, Aduthurai during 2003-2006. He headed Soil and Water Management Research (SWMR) Institute, Thanjavur for five years and Plant Clinic Centre, Tirunelveli for three years.</photoshop:CaptionWriter>
         <xmp:ModifyDate>2013-11-27T20:20:52+06:00</xmp:ModifyDate>
